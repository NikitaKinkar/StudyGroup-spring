# Frontend Environment Variables
# In production (e.g., Vercel / Netlify), set this to your deployed backend URL:
# Example: https://study-group-finder-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# WebSocket URL (optional, automatically derived from VITE_API_URL if omitted)
# Example: https://study-group-finder-backend.onrender.com/ws
VITE_WS_URL=http://localhost:8080/ws
